{
  "name": "launchpad",
  "version": "0.1.0",
  "description": "Desktop game library manager: launcher, playtime tracker, and save-file backup tool",
  "author": "Rafi Shahriyar <rafi.shahriyar@g.bracu.ac.bd>",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "verify:db": "esbuild db/verify.ts --bundle --platform=node --format=cjs --tsconfig=tsconfig.node.json --log-level=warning --outfile=out/verify/db.cjs && node out/verify/db.cjs",
    "test:e2e": "node tests/run.mjs",
    "test": "npm run verify:db && npm run test:e2e"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
